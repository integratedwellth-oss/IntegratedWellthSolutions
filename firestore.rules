rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /workshop_registrations/{document} {
      allow create: if true;
    }
    match /assessments/{document} {
      allow create: if true;
    }
    match /mail/{document} {
      allow create: if true;
    }
  }
}
