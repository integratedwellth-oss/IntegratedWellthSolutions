rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // SURGICAL FIX: Simplified rules to allow public uploads without authentication.
      // Removed complex metadata checks that were failing the preflight.
      allow write: if request.resource.size < 5 * 1024 * 1024;
      allow read: if true;
    }
  }
}
